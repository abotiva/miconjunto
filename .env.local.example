# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube al repositorio (está en .gitignore).

# --- Supabase: Settings -> API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: Settings -> Database -> Connection string (Session pooler) ---
# Se usa para migraciones y scripts, no para la aplicación en runtime.
SUPABASE_DB_URL=

# --- Opcional: correo saliente para avisos ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
